{
  "name": "@koven/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@koven/consumer-agent": "workspace:*",
    "@koven/domain": "workspace:*",
    "@koven/hedera": "workspace:*",
    "@koven/lender-agents": "workspace:*",
    "@koven/orchestrator": "workspace:*",
    "@koven/persistence": "workspace:*",
    "@koven/resource-server": "workspace:*",
    "@koven/restricted-signer": "workspace:*",
    "@koven/schemas": "workspace:*",
    "@koven/x402": "workspace:*",
    "@koven/zk-policy": "workspace:*",
    "@x402/core": "2.24.0",
    "@x402/hedera": "2.24.0",
    "@koven/directory": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
