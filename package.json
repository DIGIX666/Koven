{
  "name": "koven",
  "version": "0.0.0",
  "private": true,
  "description": "Credit and payment-policy infrastructure for autonomous x402 agents on Hedera.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --parallel --recursive --if-present dev",
    "build": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && pnpm --recursive typecheck && pnpm typecheck:scripts",
    "test": "vitest run && pnpm test:scripts",
    "test:e2e": "pnpm --filter @koven/e2e test",
    "zk:build": "pnpm --filter @koven/zk-policy build",
    "zk:setup-release": "pnpm --filter @koven/zk-policy setup-release",
    "zk:test": "pnpm --filter @koven/zk-policy test:artifacts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test:scripts": "tsx --test scripts/test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@koven/hedera": "workspace:*",
    "@types/node": "22.18.6",
    "dotenv": "16.6.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "eslint": "9.35.0",
    "@eslint/js": "9.35.0",
    "typescript-eslint": "8.42.0",
    "globals": "16.3.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@hiero-ledger/sdk": "2.85.0",
      "@ethersproject/providers@5.8.0>ws": "8.21.0",
      "jsonpath@1.3.0>underscore": "1.13.8"
    }
  },
  "dependencies": {
    "@x402/core": "2.24.0",
    "@x402/hedera": "2.24.0"
  }
}
