{
  "name": "koven",
  "version": "0.0.0",
  "private": true,
  "description": "Credit and payment-policy infrastructure for autonomous x402 agents on Hedera.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --parallel --recursive --if-present dev",
    "build": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && pnpm --recursive typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @koven/e2e test",
    "zk:build": "pnpm --filter @koven/zk-policy build",
    "zk:test": "pnpm --filter @koven/zk-policy test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "eslint": "9.35.0",
    "@eslint/js": "9.35.0",
    "typescript-eslint": "8.42.0",
    "globals": "16.3.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.6.5"
}
