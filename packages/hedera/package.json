  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "dependencies": {
    "@hiero-ledger/sdk": "2.86.2"
  },
  "devDependencies": {
    "vitest": "2.1.9"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
