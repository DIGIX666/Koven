{
  "name": "@koven/zk-policy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsx scripts/build.ts build && tsc -b tsconfig.build.json",
    "build:ts": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "setup-release": "tsx scripts/build.ts setup-release",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project @koven/zk-policy",
    "test:artifacts": "vitest run --config vitest.artifacts.config.ts"
  },
  "dependencies": {
    "@koven/domain": "workspace:*",
    "@koven/schemas": "workspace:*",
    "@koven/x402": "workspace:*",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7"
  }
}
