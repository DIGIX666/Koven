{
  "name": "@koven/audit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "dependencies": {
    "@koven/hedera": "workspace:*"
  },
  "devDependencies": {
    "vitest": "2.1.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --root ../.. --project @koven/audit",
    "test:integration": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  }
}
