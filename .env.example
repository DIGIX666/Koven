# Copy to .env for local provisioning; never commit private keys.
# Only disposable, low-balance ECDSA testnet accounts (see docs/setup.md).
# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# x402 and Blocky402
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Single-provider deployment: set to PROVIDER_A_ACCOUNT_ID initially.
X402_PAY_TO_ACCOUNT_ID=
X402_NETWORK=hedera:testnet
X402_ASSET=0.0.0
# Facilitator fee payer is discovered from /supported at runtime.

# Only the restricted signer receives CONSUMER_PRIVATE_KEY.
# Lender keys go to their respective lender processes.
# Agent accounts
CONSUMER_ACCOUNT_ID=
CONSUMER_PRIVATE_KEY=
# Public key only; scan providers use it to verify restricted-signer authorizations.
CONSUMER_PUBLIC_KEY=
LENDER_A_ACCOUNT_ID=
LENDER_A_PRIVATE_KEY=
LENDER_B_ACCOUNT_ID=
LENDER_B_PRIVATE_KEY=

# Provider payment recipients (their private keys are not needed by scan services)
PROVIDER_A_ACCOUNT_ID=
PROVIDER_B_ACCOUNT_ID=
# Provisioning/recovery only; never inject these into scan services.
PROVIDER_A_PRIVATE_KEY=
PROVIDER_B_PRIVATE_KEY=

# ZK artifacts (populated by A1; directory is ignored by Git)
ZK_ARTIFACTS_DIR=./packages/zk-policy/artifacts
ZK_CIRCUIT_ID=koven-policy-v1

# HCS audit trail
HCS_AUDIT_TOPIC_ID=

# Policy defaults (the approved recipient root is never configured: each mission's
# root is the selected provider's singleton root, provisioned through policy registration)
DEFAULT_MISSION_SPENDING_CAP=

# Local services
WEB_PORT=3000
ORCHESTRATOR_PORT=3001
DIRECTORY_PORT=3002
RESOURCE_SERVER_PORT=3003
RESTRICTED_SIGNER_PORT=3004
DATABASE_URL=./koven.db

# Paid scan providers (the launcher maps each role onto generic per-process settings)
PROVIDER_ID=prov-a
PROVIDER_A_ID=prov-a
PROVIDER_A_PORT=3003
PROVIDER_A_PRICE_TINYBAR=80000000
PROVIDER_A_LATENCY_MS=4000
PROVIDER_A_SCAN_FAILURE_MODE=none
PROVIDER_A_PUBLIC_URL=http://127.0.0.1:3003
PROVIDER_A_DATABASE_URL=./koven-provider-a.db
PROVIDER_A_CALLBACK_SECRET=
PROVIDER_B_ID=prov-b
PROVIDER_B_PORT=3013
PROVIDER_B_PRICE_TINYBAR=45000000
PROVIDER_B_LATENCY_MS=9000
PROVIDER_B_SCAN_FAILURE_MODE=none
PROVIDER_B_PUBLIC_URL=http://127.0.0.1:3013
PROVIDER_B_DATABASE_URL=./koven-provider-b.db
PROVIDER_B_CALLBACK_SECRET=
RESOURCE_SERVER_PUBLIC_URL=http://127.0.0.1:3003
# Interface the provider listens on; default 127.0.0.1. Use 0.0.0.0 when the
# public URL must be reachable from other hosts (behind TLS, see docs/setup.md).
RESOURCE_SERVER_HOST=127.0.0.1
RESOURCE_SERVER_DATABASE_URL=./koven-provider-a.db
CALLBACK_URL=http://127.0.0.1:3001/callbacks/mission-complete
# Unpadded base64url encoding of exactly 32 random bytes.
CALLBACK_SECRET=

# Restricted signer (the only process that receives CONSUMER_PRIVATE_KEY)
# Interface the signer listens on; default 127.0.0.1.
RESTRICTED_SIGNER_HOST=127.0.0.1
# Milestone configuration of the payment gate: "deterministic" (M2) or "zk" (M3, proof required).
SIGNER_PROOF_MODE=deterministic
# zk mode only: the signer's own copy of the official verification key and its reviewed SHA-256 pin
# (artifacts-manifest.json vkeyHash). Startup fails unless the file bytes hash to the pin.
SIGNER_VERIFICATION_KEY_PATH=./packages/zk-policy/artifacts/official/koven-policy-v1/verification_key.json
SIGNER_TRUSTED_VKEY_SHA256=2d23ff5d6058a4de330abee1fdc1b68905da223f9ad8bdb681d598e38b6a257d

# Lenders (each lender process verifies borrower proof bundles independently)
# "deterministic" (M2) or "zk" (M3: /credit/accept requires and verifies the payment intent and proof).
LENDER_PROOF_MODE=deterministic
# zk mode only: the lender's own copy of the verification key and its reviewed pin; never taken from a borrower.
LENDER_VERIFICATION_KEY_PATH=./packages/zk-policy/artifacts/official/koven-policy-v1/verification_key.json
LENDER_TRUSTED_VKEY_SHA256=2d23ff5d6058a4de330abee1fdc1b68905da223f9ad8bdb681d598e38b6a257d
# Independently generated opaque service credentials: 32+ random bytes, unpadded base64url.
# Each maps to one role in the signer; no two may be equal.
SIGNER_CONSUMER_CREDENTIAL=
SIGNER_ORCHESTRATOR_CREDENTIAL=
SIGNER_REGISTRAR_CREDENTIAL=
# Lender credential -> lender account: "<accountId>:<credential>;<accountId>:<credential>"
SIGNER_LENDER_CREDENTIALS=
# Pinned lender ECDSA public keys: "<accountId>:<publicKey>;..."
SIGNER_LENDER_PUBLIC_KEYS=
# Provider callback secrets shared with the callback verifiers: "<providerId>:<CALLBACK_SECRET>;..."
SIGNER_PROVIDER_CALLBACK_SECRETS=

# Competition services; each lender has its own database and credentials.
LENDER_A_PORT=3005
LENDER_B_PORT=3015
LENDER_A_URL=http://127.0.0.1:3005
LENDER_B_URL=http://127.0.0.1:3015
LENDER_A_DATABASE_URL=./koven-lender-a.db
LENDER_B_DATABASE_URL=./koven-lender-b.db
LENDER_A_REGISTRAR_CREDENTIAL=
LENDER_B_REGISTRAR_CREDENTIAL=
LENDER_A_SIGNER_CREDENTIAL=
LENDER_B_SIGNER_CREDENTIAL=
LENDER_BORROWER_REPUTATION=0.9
SIGNER_URL=http://127.0.0.1:3004
# Optional JSON metadata array without reputationScore; otherwise use PROVIDER_A/B fields.
DIRECTORY_PROVIDERS_FILE=
REGISTRAR_PORT=3006
REGISTRAR_DATABASE_URL=./koven-registrar.db
# Available only to the operator and registrar process.
REGISTRAR_OPERATOR_CREDENTIAL=
